# ==============================================================================
# KAISER — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Metadata
APP_NAME=KAISER
APP_ENV=development
LOG_LEVEL=INFO

# Interaction & Voice Settings
KAISER_LANGUAGE_MODE=tanglish
VOICE_ENABLED=true

# Speech-to-Text (STT) Settings
# Provider options: 'mock' (default safe offline mock) or 'local_whisper' (offline faster-whisper)
# For 'local_whisper', install requirements-stt.txt and provide path to local CTranslate2 model directory:
STT_PROVIDER=mock
# STT_MODEL_PATH=data/models/whisper/whisper-base
STT_MODEL_PATH=
STT_MODEL_ID=whisper-base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Text-to-Speech (TTS) Settings
TTS_PROVIDER=mock
TTS_VOICE_ID=
TTS_RATE=175
TTS_VOLUME=1.0

# Audio Playback Settings
PLAYBACK_ENABLED=false
PLAYBACK_DEVICE_ID=

# Market Data & Broker (Safe Defaults / Mock)
# MARKET_DATA_PROVIDER options: 'mock' (default safe offline mock) or 'twelvedata' (Twelve Data live/delayed API)
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=none

# Twelve Data Provider Configuration (Required only when MARKET_DATA_PROVIDER=twelvedata)
# Free API key can be obtained from https://twelvedata.com (no credit card required)
# Free tier: 8 requests/minute, 800 requests/day, 15-minute delayed data for Indian equities
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOLS=RELIANCE,TCS,INFY
TWELVE_DATA_EXCHANGE=NSE
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_RATE_LIMIT_PER_MINUTE=8
TWELVE_DATA_POLL_INTERVAL_SECONDS=15.0
TWELVE_DATA_TIMEOUT_SECONDS=10.0
TWELVE_DATA_IS_DELAYED=true


# Paper Execution Engine & Simulated Broker (Phase 2, Step 53)
# Explicit paper execution flag; default disabled. Isolated from live trading.
PAPER_EXECUTION_ENABLED=false
PAPER_INITIAL_CASH=100000.0
PAPER_MAX_ORDER_NOTIONAL=50000.0
PAPER_MAX_POSITION_EXPOSURE_PCT=50.0
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0002
PAPER_FRESHNESS_THRESHOLD_SECONDS=60.0

# Portfolio Analytics Dashboard & Access Control (Phase 2, Steps 12, 56, 57, & 58)
# Local loopback-only dashboard server. Strictly read-only; disabled by default.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT must be between 1 and 65535 (or 0 for ephemeral dynamic allocation in test/dev environments).
DASHBOARD_PORT=8080
# Authorization Secret Token (Bearer token or X-API-Key).
# - When DASHBOARD_AUTH_TOKEN is configured or DASHBOARD_REQUIRE_AUTH=true, all sensitive
#   API data endpoints (/api/* except public health /api/status) require valid credentials.
# - If DASHBOARD_REQUIRE_AUTH=true but DASHBOARD_AUTH_TOKEN is empty/unset, the server fails closed (HTTP 403 Forbidden).
# - If both Authorization and X-API-Key headers are provided, both must match the token.
# - Tokens in URL query parameters are rejected.
# - Unauthenticated local development mode is permitted only when DASHBOARD_REQUIRE_AUTH=false
#   and DASHBOARD_AUTH_TOKEN is empty, strictly over loopback interfaces.
DASHBOARD_AUTH_TOKEN=
DASHBOARD_REQUIRE_AUTH=false

# Database & Storage
DATABASE_URL=sqlite:///data/kaiser.db

# Database Backup & Disaster Recovery (Phase 2, Steps 78 & 79)
# Directory where verified SQLite backups and metadata sidecars are published.
BACKUP_DIR=data/backups
# Automated retention pruning is disabled by default. When enabled, prunes older verified backups exceeding max count.
BACKUP_RETENTION_ENABLED=false
BACKUP_RETENTION_MAX_COUNT=5
BACKUP_RETENTION_MAX_AGE_DAYS=30.0
BACKUP_PRUNE_BATCH_SIZE=50
# Scheduled backup daemon is disabled by default. Safe offline default.
BACKUP_SCHEDULER_ENABLED=false
BACKUP_INTERVAL_SECONDS=3600.0
BACKUP_HEALTH_MAX_AGE_SECONDS=86400.0
BACKUP_RETRY_MAX_ATTEMPTS=3
BACKUP_SHUTDOWN_TIMEOUT_SECONDS=5.0
# Disaster recovery drill automation; disabled by default.
RECOVERY_DRILL_ENABLED=false

# LLM Intelligence Providers (Mock defaults for foundation)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
