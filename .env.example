# ==============================================================================
# KAISER — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Metadata
APP_NAME=KAISER
APP_ENV=development
LOG_LEVEL=INFO

# Interaction & Voice Settings
KAISER_LANGUAGE_MODE=tanglish
VOICE_ENABLED=true

# Speech-to-Text (STT) Settings
STT_PROVIDER=mock
STT_MODEL_PATH=
STT_MODEL_ID=whisper-base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Text-to-Speech (TTS) Settings
TTS_PROVIDER=mock
TTS_VOICE_ID=
TTS_RATE=175
TTS_VOLUME=1.0

# Audio Playback Settings
PLAYBACK_ENABLED=false
PLAYBACK_DEVICE_ID=

# Market Data & Broker (Safe Defaults / Mock)
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=none

# Database & Storage
DATABASE_URL=sqlite:///data/kaiser.db

# LLM Intelligence Providers (Mock defaults for foundation)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
