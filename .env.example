# ==============================================================================
# KAISER — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Metadata
APP_NAME=KAISER
APP_ENV=development
LOG_LEVEL=INFO

# Interaction & Voice Settings
KAISER_LANGUAGE_MODE=tanglish
VOICE_ENABLED=true

# Speech-to-Text (STT) Settings
# Provider options: 'mock' (default safe offline mock) or 'local_whisper' (offline faster-whisper)
# For 'local_whisper', install requirements-stt.txt and provide path to local CTranslate2 model directory:
STT_PROVIDER=mock
# STT_MODEL_PATH=data/models/whisper/whisper-base
STT_MODEL_PATH=
STT_MODEL_ID=whisper-base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Text-to-Speech (TTS) Settings
TTS_PROVIDER=mock
TTS_VOICE_ID=
TTS_RATE=175
TTS_VOLUME=1.0

# Audio Playback Settings
PLAYBACK_ENABLED=false
PLAYBACK_DEVICE_ID=

# Market Data & Broker (Safe Defaults / Mock)
# MARKET_DATA_PROVIDER options: 'mock' (default safe offline mock) or 'twelvedata' (Twelve Data live/delayed API)
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=none

# Twelve Data Provider Configuration (Required only when MARKET_DATA_PROVIDER=twelvedata)
# Free API key can be obtained from https://twelvedata.com (no credit card required)
# Free tier: 8 requests/minute, 800 requests/day, 15-minute delayed data for Indian equities
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOLS=RELIANCE,TCS,INFY
TWELVE_DATA_EXCHANGE=NSE
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_RATE_LIMIT_PER_MINUTE=8
TWELVE_DATA_POLL_INTERVAL_SECONDS=15.0
TWELVE_DATA_TIMEOUT_SECONDS=10.0
TWELVE_DATA_IS_DELAYED=true


# Paper Execution Engine & Simulated Broker (Phase 2, Step 53)
# Explicit paper execution flag; default disabled. Isolated from live trading.
PAPER_EXECUTION_ENABLED=false
PAPER_INITIAL_CASH=100000.0
PAPER_MAX_ORDER_NOTIONAL=50000.0
PAPER_MAX_POSITION_EXPOSURE_PCT=50.0
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0002
PAPER_FRESHNESS_THRESHOLD_SECONDS=60.0

# Portfolio Analytics Dashboard & Access Control (Phase 2, Step 12 & Step 56)
# Local loopback-only dashboard server. Disabled by default.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Optional access token for dashboard access (Bearer token or X-API-Key).
# In non-development or when DASHBOARD_REQUIRE_AUTH=true, access requires this token.
DASHBOARD_AUTH_TOKEN=
DASHBOARD_REQUIRE_AUTH=false

# Database & Storage
DATABASE_URL=sqlite:///data/kaiser.db

# LLM Intelligence Providers (Mock defaults for foundation)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
